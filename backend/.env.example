# Database Connection (PostgreSQL / Supabase Connection Pooler)
# For Supabase, use the connection pooler URL (IPv4 compatible):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SQLALCHEMY_DATABASE_URI=postgresql://postgres.your_project_ref:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Environment mode ('development' uses Nvidia; 'production' uses Vertex AI Gemini 2.5 Pro)
ENVIRONMENT=development

# Google Cloud Vertex AI Configuration (Used in Production)
USE_VERTEX_AI=true
GCP_PROJECT_ID=project-e3e4dcb5-593d-4e61-9a8
GCP_LOCATION=us-central1
GCP_PRIMARY_MODEL=gemini-2.5-pro
GCP_SECONDARY_MODEL=gemini-2.5-flash
GCP_MODEL=gemini-2.5-pro

# Nvidia NIM AI API (Fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
