# Database Connection (PostgreSQL / Amazon RDS / Supabase)
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@localhost:5432/yaduk

# Environment mode ('production' or 'development')
ENVIRONMENT=production

# AWS Bedrock Configuration (Primary Track 2 Cloud Agent Engine)
AWS_BEDROCK_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenRouter Secondary Fallback (nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Groq Tertiary Fallback LLM Engine (openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
