# Database Connection (PostgreSQL / Amazon RDS / Supabase)
SQLALCHEMY_DATABASE_URI=postgresql://postgres:password@localhost:5432/yaduk

# Environment mode ('production' or 'development')
ENVIRONMENT=production

# AWS Bedrock Configuration (Primary AI Cloud Agent Engine)
AWS_BEDROCK_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# NVIDIA NIM Secondary Fallback (nvidia/nemotron-3-ultra-550b-a55b)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Groq Tertiary Fallback LLM Engine (openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# JWT Authentication (CHANGE IN PRODUCTION — use a strong random secret)
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# Amazon S3 — Artifact Storage (Blueprints, Codebases)
S3_BUCKET_NAME=yaduk-artifacts
S3_REGION=us-east-1

# Amazon CloudWatch — AI Agent Observability Metrics
CLOUDWATCH_NAMESPACE=Yaduk/AIAgents
CLOUDWATCH_ENABLED=true

# CORS — Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.amplifyapp.com
